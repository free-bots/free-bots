                <div class="avatar-frame">
                    <img class="avatar" src="https://avatars.githubusercontent.com/u/54210595" />
                </div>
                <div class="robot"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 22" shape-rendering="crispEdges"><rect x="9" y="0" width="2" height="1" fill="#bd93f9"/><rect x="9" y="1" width="2" height="1" fill="#191a21"/><rect x="8" y="2" width="4" height="1" fill="#191a21"/><rect x="3" y="3" width="14" height="1" fill="#191a21"/><rect x="2" y="4" width="1" height="1" fill="#191a21"/><rect x="3" y="4" width="13" height="1" fill="#f8f8f2"/><rect x="16" y="4" width="1" height="1" fill="#c6c8d1"/><rect x="17" y="4" width="1" height="1" fill="#191a21"/><rect x="2" y="5" width="1" height="1" fill="#191a21"/><rect x="3" y="5" width="1" height="1" fill="#f8f8f2"/><rect x="4" y="5" width="12" height="1" fill="#191a21"/><rect x="16" y="5" width="1" height="1" fill="#c6c8d1"/><rect x="17" y="5" width="1" height="1" fill="#191a21"/><rect x="2" y="6" width="1" height="1" fill="#191a21"/><rect x="3" y="6" width="1" height="1" fill="#f8f8f2"/><rect x="4" y="6" width="1" height="1" fill="#191a21"/><rect x="5" y="6" width="2" height="1" fill="#50fa7b"/><rect x="7" y="6" width="6" height="1" fill="#191a21"/><rect x="13" y="6" width="2" height="1" fill="#50fa7b"/><rect x="15" y="6" width="1" height="1" fill="#191a21"/><rect x="16" y="6" width="1" height="1" fill="#c6c8d1"/><rect x="17" y="6" width="1" height="1" fill="#191a21"/><rect x="1" y="7" width="2" height="1" fill="#191a21"/><rect x="3" y="7" width="1" height="1" fill="#f8f8f2"/><rect x="4" y="7" width="1" height="1" fill="#191a21"/><rect x="5" y="7" width="2" height="1" fill="#50fa7b"/><rect x="7" y="7" width="6" height="1" fill="#191a21"/><rect x="13" y="7" width="2" height="1" fill="#50fa7b"/><rect x="15" y="7" width="1" height="1" fill="#191a21"/><rect x="16" y="7" width="1" height="1" fill="#c6c8d1"/><rect x="17" y="7" width="2" height="1" fill="#191a21"/><rect x="1" y="8" width="1" height="1" fill="#191a21"/><rect x="2" y="8" width="1" height="1" fill="#ff79c6"/><rect x="3" y="8" width="1" height="1" fill="#f8f8f2"/><rect x="4" y="8" width="12" height="1" fill="#191a21"/><rect x="16" y="8" width="1" height="1" fill="#c6c8d1"/><rect x="17" y="8" width="1" height="1" fill="#ff79c6"/><rect x="18" y="8" width="1" height="1" fill="#191a21"/><rect x="1" y="9" width="2" height="1" fill="#191a21"/><rect x="3" y="9" width="1" height="1" fill="#f8f8f2"/><rect x="4" y="9" width="4" height="1" fill="#191a21"/><rect x="8" y="9" width="4" height="1" fill="#ff79c6"/><rect x="12" y="9" width="4" height="1" fill="#191a21"/><rect x="16" y="9" width="1" height="1" fill="#c6c8d1"/><rect x="17" y="9" width="2" height="1" fill="#191a21"/><rect x="2" y="10" width="1" height="1" fill="#191a21"/><rect x="3" y="10" width="13" height="1" fill="#f8f8f2"/><rect x="16" y="10" width="1" height="1" fill="#c6c8d1"/><rect x="17" y="10" width="1" height="1" fill="#191a21"/><rect x="2" y="11" width="16" height="1" fill="#191a21"/><rect x="4" y="12" width="1" height="1" fill="#191a21"/><rect x="5" y="12" width="10" height="1" fill="#6272a4"/><rect x="15" y="12" width="1" height="1" fill="#191a21"/><rect x="3" y="13" width="14" height="1" fill="#191a21"/><rect x="2" y="14" width="1" height="1" fill="#191a21"/><rect x="3" y="14" width="13" height="1" fill="#f8f8f2"/><rect x="16" y="14" width="1" height="1" fill="#c6c8d1"/><rect x="17" y="14" width="1" height="1" fill="#191a21"/><rect x="2" y="15" width="1" height="1" fill="#191a21"/><rect x="3" y="15" width="4" height="1" fill="#f8f8f2"/><rect x="7" y="15" width="2" height="1" fill="#50fa7b"/><rect x="9" y="15" width="2" height="1" fill="#f8f8f2"/><rect x="11" y="15" width="2" height="1" fill="#50fa7b"/><rect x="13" y="15" width="3" height="1" fill="#f8f8f2"/><rect x="16" y="15" width="1" height="1" fill="#c6c8d1"/><rect x="17" y="15" width="1" height="1" fill="#191a21"/><rect x="2" y="16" width="1" height="1" fill="#191a21"/><rect x="3" y="16" width="3" height="1" fill="#f8f8f2"/><rect x="6" y="16" width="2" height="1" fill="#50fa7b"/><rect x="8" y="16" width="2" height="1" fill="#f8f8f2"/><rect x="10" y="16" width="2" height="1" fill="#50fa7b"/><rect x="12" y="16" width="4" height="1" fill="#f8f8f2"/><rect x="16" y="16" width="1" height="1" fill="#c6c8d1"/><rect x="17" y="16" width="1" height="1" fill="#191a21"/><rect x="2" y="17" width="1" height="1" fill="#191a21"/><rect x="3" y="17" width="2" height="1" fill="#f8f8f2"/><rect x="5" y="17" width="2" height="1" fill="#50fa7b"/><rect x="7" y="17" width="2" height="1" fill="#f8f8f2"/><rect x="9" y="17" width="2" height="1" fill="#50fa7b"/><rect x="11" y="17" width="5" height="1" fill="#f8f8f2"/><rect x="16" y="17" width="1" height="1" fill="#c6c8d1"/><rect x="17" y="17" width="1" height="1" fill="#191a21"/><rect x="2" y="18" width="1" height="1" fill="#191a21"/><rect x="3" y="18" width="13" height="1" fill="#f8f8f2"/><rect x="16" y="18" width="1" height="1" fill="#c6c8d1"/><rect x="17" y="18" width="1" height="1" fill="#191a21"/><rect x="2" y="19" width="16" height="1" fill="#191a21"/><rect x="4" y="20" width="1" height="1" fill="#191a21"/><rect x="5" y="20" width="1" height="1" fill="#6272a4"/><rect x="6" y="20" width="1" height="1" fill="#191a21"/><rect x="13" y="20" width="1" height="1" fill="#191a21"/><rect x="14" y="20" width="1" height="1" fill="#6272a4"/><rect x="15" y="20" width="1" height="1" fill="#191a21"/><rect x="3" y="21" width="5" height="1" fill="#191a21"/><rect x="12" y="21" width="5" height="1" fill="#191a21"/></svg></div>
            </div>
        </header>

        <!-- STATUS STRIP -->
        <div class="status">
            <div class="status-cell">
                <span class="label">SYS.STATUS</span>
                <span class="value"><span class="blink">&#9646;</span> ONLINE</span>
            </div>
            <div class="status-cell">
                <span class="label">TIMEZONE</span>
                <span class="value">EUROPE / BERLIN</span>
            </div>
            <div class="status-cell">
                <span class="label">UPLINK</span>
                <span class="value">GITHUB.COM</span>
            </div>
            <div class="status-bar"><div class="status-bar-fill"></div></div>
        </div>
        <div class="hazard"></div>

        <!-- METRICS -->
        <div class="grid">
            <div class="cy-row">
                <div class="panel">
                    <span class="chip chip-tag">MOD.01 // ACTIVITY</span>
                    {{#if activityData}}
                    <div class="stat-grid">
                        {{#each activityData}}
                        <div class="stat{{#if zero}} stat-zero{{/if}}">
                            <div class="stat-value">{{value}}</div>
                            <div class="stat-label">// {{label}}</div>
                        </div>
                        {{/each}}
                    </div>
                    {{else}}
                    <div class="panel-body">{{{activity}}}</div>
                    {{/if}}
                </div>
                <div class="panel">
                    <span class="chip chip-tag">MOD.02 // COMMUNITY</span>
                    {{#if communityData}}
                    <div class="stat-grid">
                        {{#each communityData}}
                        <div class="stat{{#if zero}} stat-zero{{/if}}">
                            <div class="stat-value">{{value}}</div>
                            <div class="stat-label">// {{label}}</div>
                        </div>
                        {{/each}}
                    </div>
                    {{else}}
                    <div class="panel-body">{{{community}}}</div>
                    {{/if}}
                </div>
            </div>

            <div class="panel">
                <span class="chip chip-tag">MOD.03 // LANGUAGES</span>
                {{#if languageData}}
                <div class="lang">
                    <div class="lang-head">
                        <span class="lang-total">{{languageData.total}}</span>
                        <span class="lang-total-label">LANGUAGES<br />DETECTED</span>
                        <span class="lang-sub">// MOST USED &middot; BY BYTES</span>
                    </div>
                    <div class="mosaic">
                        {{#each languageData.mosaic}}<span style="background:{{color}}"></span>{{/each}}
                    </div>
                    <div class="lang-rows">
                        {{#each languageData.items}}
                        <div class="lang-row">
                            <span class="lang-swatch" style="background:{{color}}"></span>
                            <span class="lang-name">{{name}}</span>
                            <span class="lang-blocks">
                                {{#each blocks}}<span{{#if on}} style="background:{{../color}}"{{/if}}></span>{{/each}}
                            </span>
                            <span class="lang-percent">{{percentLabel}}<small>%</small></span>
                            <span class="lang-size">{{size}}</span>
                        </div>
                        {{/each}}
                    </div>
                </div>
                {{else}}
                <div class="panel-body">{{{languages}}}</div>
                {{/if}}
            </div>

            <div class="panel">
                <span class="chip chip-tag">MOD.04 // ACHIEVEMENTS</span>
                {{#if achievementData}}
                <div class="ach-grid">
                    {{#each achievementData}}
                    <div class="ach ach-{{rank}}">
                        <span class="ach-rank">{{rankLabel}}</span>
                        <span class="ach-value">{{value}}</span>
                        <div class="ach-icon"><img class="ach-icon-img" data-pixelate data-grid="22" data-scale="4" src="{{iconSrc}}" alt="{{title}}" width="48" height="48" /></div>
                        <div class="ach-prefix">{{#if prefix}}{{prefix}}{{else}}&nbsp;{{/if}}</div>
                        <div class="ach-title">{{title}}</div>
                        <div class="ach-blocks">{{#each blocks}}<span{{#if on}} class="on"{{/if}}></span>{{/each}}</div>
                    </div>
                    {{/each}}
                </div>
                {{else}}
                <div class="panel-body">{{{achievements}}}</div>
                {{/if}}
            </div>

            <div id="end" class="panel panel-pink">
                <span class="chip chip-tag">MOD.05 // LOADOUT</span>
                {{#*inline "skillGroup"}}
                <div class="loadout-group">
                    <div class="group-head">// {{title}} <span class="group-count">[{{count}}]</span></div>
                    <div class="slots">
                        {{#each items}}
                        <div class="slot">
                            <img class="skill-icon" data-pixelate src="{{src}}" alt="{{name}}" width="44" height="44" />
                            <span class="slot-name">{{name}}</span>
                        </div>
                        {{/each}}
                    </div>
                </div>
                {{/inline}}
                <div class="loadout">
                    {{#with skillGroups.[0]}}
                    <div class="loadout-primary">{{> skillGroup}}</div>
                    {{/with}}
                    <div class="loadout-cols">
                        {{#each skillGroups}}{{#unless @first}}{{> skillGroup}}{{/unless}}{{/each}}
                    </div>
                </div>
                <div class="footer-line">// END OF TRANSMISSION <span class="blink">&#9646;</span></div>
            </div>
        </div>
    </div>
    <script src="pixelate.js"></script>
</body>

</html>
